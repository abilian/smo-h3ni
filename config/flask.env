DB_HOST='postgres'
DB_NAME='smo'
DB_USER='smo_user'
DB_PASSWORD='smo_pass'

#PGUSER: root
#POSTGRES_USER: smo_user
#POSTGRES_PASSWORD: smo_pass
#POSTGRES_DB: smo_test

# Filename of the Karmada API server config that must be located inside the ~/.kube directory
KARMADA_KUBECONFIG='karmada-apiserver.config'
# Base URL of the NVFCL API
NFVCL_BASE_URL='http://192.168.12.64:5002'
# Flag to set if container/artifact registry doesn't use HTTPS
INSECURE_REGISTRY=True
# URL of the Prometheus instance
PROMETHEUS_HOST='http://10.0.3.53:30090'
# Interval in seconds that the algorithm will run
SCALING_INTERVAL=30
# Grafana host
GRAFANA_HOST='http://10.0.2.114:30095'
GRAFANA_USERNAME='admin'
GRAFANA_PASSWORD='prom-operator'
# Scaling algorithm that runs periodically per cluster
SCALING_ENABLED=False
